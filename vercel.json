{
  "version": 2,
  "builds": [
    {
      "src": "src/server.js",
      "use": "@vercel/node",
      "config": { "maxLambdaSize": "50mb" }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/src/server.js"
    },
    {
      "src": "/app.js",
      "headers": { "Cache-Control": "no-cache, no-store, must-revalidate" },
      "dest": "/public/app.js"
    },
    {
      "src": "/style.css",
      "headers": { "Cache-Control": "no-cache, no-store, must-revalidate" },
      "dest": "/public/style.css"
    },
    {
      "src": "/index.html",
      "headers": { "Cache-Control": "no-cache, no-store, must-revalidate" },
      "dest": "/public/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}