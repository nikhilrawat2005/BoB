# =============================================================================
#  Bob Backend — Environment Variables
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env to git — it is listed in .gitignore.
# =============================================================================

# --- OpenRouter API Keys (LLM) -----------------------------------------------
# Add up to 11 keys. The service rotates through them round-robin to spread
# load and avoid rate-limits. Leave unused slots blank (KEY3= is fine).
OPENROUTER_API_KEY1=sk-or-v1-xxxxxxxxxxxxxxxx
OPENROUTER_API_KEY2=sk-or-v1-xxxxxxxxxxxxxxxx
OPENROUTER_API_KEY3=
OPENROUTER_API_KEY4=
OPENROUTER_API_KEY5=
OPENROUTER_API_KEY6=
OPENROUTER_API_KEY7=
OPENROUTER_API_KEY8=
OPENROUTER_API_KEY9=
OPENROUTER_API_KEY10=
OPENROUTER_API_KEY11=

# --- Model Configuration ------------------------------------------------------
# Which model handles each role. See src/services/llmService.js → MODEL_ROLES.
WRITER_MODEL=deepseek/deepseek-chat-v3
REVIEW_MODEL=anthropic/claude-sonnet-4
AUDITOR_MODEL=openai/gpt-4o
# Vision model for screenshot analysis, YouTube thumbnails, and Instagram reel thumbnails
# Gemini Flash supports vision for free (already in use as WRITER_MODEL)
VISION_MODEL=google/gemini-2.0-flash-001

# --- Generation Settings ------------------------------------------------------
TEMPERATURE=0.2
MAX_TOKENS=16000

# --- Firebase Admin (Auth verification + Firestore memory storage) ------------
# Get these from Firebase Console -> Project Settings -> Service Accounts
# -> Generate new private key  (downloads a JSON — copy the three fields below)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXX\n-----END PRIVATE KEY-----\n"

# --- Firebase Client SDK (Web app config served via /api/config) --------------
FIREBASE_CLIENT_API_KEY=your-firebase-client-api-key
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
FIREBASE_APP_ID=your-app-id

# --- Access Control -----------------------------------------------------------
# Comma-separated list of allowed user emails
ALLOWED_EMAILS=nikhil2005114@gmail.com,nikhilrawat42005@gmail.com,nikhilrawat4112005@gmail.com,nikhilrawat2005114@gmail.com
SHARED_ADMIN_ID=nikhil_master_workspace

# --- Cloudinary (image/video/file storage) ------------------------------------
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# --- Server -------------------------------------------------------------------
PORT=3000
ALLOWED_ORIGIN=http://localhost:3000

# --- Live Data (weather / news / markets) --------------------------------------
# All three use free, key-less APIs (Open-Meteo, public RSS feeds, Yahoo Finance).
# DEFAULT_CITY is used for weather in the daily briefing and proactive greeting.
# DEFAULT_LAT / DEFAULT_LON override the city's built-in coordinates if needed.
DEFAULT_CITY=New Delhi
DEFAULT_LAT=
DEFAULT_LON=

# --- Scheduler Cron ------------------------------------------------------------
# Secret sent by the GitHub Actions workflow (.github/workflows/tick.yml) as
# "Authorization: Bearer <CRON_SECRET>" when it calls POST /api/scheduler/tick
# every hour. Set the same value in:
#   - Vercel project settings -> Environment Variables (so the server can validate it)
#   - GitHub repo settings  -> Secrets and variables -> Actions -> CRON_SECRET
# If not set, /api/scheduler/tick falls back to normal Firebase auth.
CRON_SECRET=

# --- Secret Vault -------------------------------------------------------------
# 4-digit PIN that protects Master Nikhil's private Secret Vault.
# Change this to any 4-digit code you prefer. Default: 2005
SECRET_VAULT_PIN=2005
