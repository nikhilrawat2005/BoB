# =============================================================================
#  Bob Backend — Environment Variables
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env to git — it is listed in .gitignore.
# =============================================================================

# --- OpenRouter API Keys (LLM) -----------------------------------------------
# Add up to 11 keys. The service rotates through them round-robin to spread
# load and avoid rate-limits. Leave unused slots blank (KEY3= is fine).
# To LOCK a key to a fixed role (stable identity across restarts, shown in the
# HQ "Keys" card as role BOB / CENTER / BUILDER), point its env var at the SAME
# sk-or-v1-... string used by OPENROUTER_API_KEY#.
#   BOB_API_KEY     -> Bob's main rotation key
#   CENTER_API_KEY  -> Center work key
#   BUILDER_API_KEY -> Builder persona key (auto-excluded from Bob's pool)
# LIKE the main pool, the Builder persona ALSO supports multi-key rotation
# (BUILDER_API_KEY1 / BUILDER_API_KEY2, see below) so one exhausting builder
# key never bricks SEO audits or builder chats.
# Any configured key without a role is a REPLACEMENT (swap-in when a role key
# exhausts).
OPENROUTER_API_KEY1=sk-or-v1-xxxxxxxxxxxxxxxx
OPENROUTER_API_KEY2=sk-or-v1-xxxxxxxxxxxxxxxx
OPENROUTER_API_KEY3=
OPENROUTER_API_KEY4=
OPENROUTER_API_KEY5=
OPENROUTER_API_KEY6=
OPENROUTER_API_KEY7=
OPENROUTER_API_KEY8=
OPENROUTER_API_KEY9=
OPENROUTER_API_KEY10=
OPENROUTER_API_KEY11=

# Per-key role assignment (optional but recommended): pin a specific key to a role.
# When that key exhausts, Bob auto-promotes to a fresh replacement key and the
# dashboard label follows (Firestore-backed, atomic). BUILDER_API_KEY below.
BOB_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxx
CENTER_API_KEY=sk-or-v1-xxxxxxxxxxxxx2

# --- Model Configuration ------------------------------------------------------
# Which model handles each role. See src/services/llmService.js → MODEL_ROLES.
#
# Models are auto-selected at call time by resolveModel(). It reads MODEL_CAPS
# (vision support / context size / cost tier) and will automatically SHIFT off
# the configured model if that model cannot do the job — e.g. images attached to
# a text-only model, or a prompt too big for the model's context window.
# Any slug you put here must exist in MODEL_CAPS in llmService.js, otherwise it
# is treated as "unknown capabilities" and gets conservative handling.
#
# Default chat/writer model. gemini-2.5-flash-lite is vision-capable, 1M context,
# $0.10/$0.40 per M tokens — it covers text + images + big docs with no shift.
WRITER_MODEL=google/gemini-2.5-flash-lite
# Reasoning/review tasks (hackathon parsing, stalking profile summaries).
# $0.30/$2.50 per M vs claude-sonnet-4's $3/$15 = 10x cheaper input.
REVIEW_MODEL=google/gemini-2.5-flash
AUDITOR_MODEL=google/gemini-2.5-flash
# Vision model for screenshots, YouTube thumbnails, Instagram reel thumbnails.
# MUST be a slug that has live endpoints AND accepts image input.
# WARNING: google/gemini-2.0-flash-001 is retired — it resolves but has ZERO
# serving endpoints, so every vision call using it fails. Do not use it.
VISION_MODEL=google/gemini-2.5-flash-lite
# Cheapest tier. Used for router/classifier/summarizer calls that only emit a
# few tokens (behaviorEngine trait detection, memory summarize, session titles).
# Falls back to WRITER_MODEL if unset.
CHEAP_MODEL=google/gemini-2.5-flash-lite

# --- Bob the Builder (dedicated persona keys + model) ---------------------------
# The "Bob the Builder" persona (project planning / prompt packs / GitHub repo
# self-read) runs on its own OpenRouter keys so it never shares rate limits with
# the main Bob pool. These keys are automatically EXCLUDED from Bob's pool.
# Multi-key rotation: list up to 30 as BUILDER_API_KEY1, BUILDER_API_KEY2, …
# The pool rotates round-robin, skips builder keys that exhaust (auto-retired on
# a credit failure), and only falls back to Bob's shared pool when ALL builder
# keys are dead. BUILDER_API_KEY (below) is kept as the legacy alias for #1.
# BUILDER_MODEL is a strong planning model (deepseek-chat-v3 is cheap + capable).
BUILDER_API_KEY1=
BUILDER_API_KEY2=
BUILDER_API_KEY=
BUILDER_MODEL=deepseek/deepseek-chat-v3

# --- GitHub Repo Self-Read -------------------------------------------------------
# Optional. Lets Bob the Builder read PRIVATE repositories and raises the GitHub
# API rate limit (anonymous is 60 requests/hour). Create a fine-grained PAT with
# "Contents: Read" on the repos you want to analyze. Public repos work without it.
GITHUB_TOKEN=

# --- Generation Settings ------------------------------------------------------
TEMPERATURE=0.2
# Output ceiling per call. This is a CAP, not a reservation — you are billed only
# for tokens actually generated. Keeping it modest stops the model rambling AND
# avoids OpenRouter's upfront credit precheck (max_tokens x output price) from
# falsely marking low-balance keys as CREDIT_EXHAUSTED.
MAX_TOKENS=2500
# Bob's own per-key token budget before it rotates to the next key in the pool.
MAX_TOKENS_PER_KEY=150000
# Ceiling on the diff size selfEditService will send to the LLM.
SELF_EDIT_MAX_DIFF_CHARS=2000

# --- Firebase Admin (Auth verification + Firestore memory storage) ------------
# Get these from Firebase Console -> Project Settings -> Service Accounts
# -> Generate new private key  (downloads a JSON — copy the three fields below)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXX\n-----END PRIVATE KEY-----\n"

# --- Firebase Client SDK (Web app config served via /api/config) --------------
FIREBASE_CLIENT_API_KEY=your-firebase-client-api-key
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
FIREBASE_APP_ID=your-app-id

# --- Access Control -----------------------------------------------------------
# Comma-separated list of allowed user emails
ALLOWED_EMAILS=nikhil2005114@gmail.com,nikhilrawat42005@gmail.com,nikhilrawat4112005@gmail.com,nikhilrawat2005114@gmail.com,nikhilrawat2005@gmail.com
SHARED_ADMIN_ID=nikhil_master_workspace

# --- Cloudinary (image/video/file storage) ------------------------------------
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# --- Server -------------------------------------------------------------------
PORT=3000
ALLOWED_ORIGIN=http://localhost:3000

# --- Live Data (weather / news / markets) --------------------------------------
# All three use free, key-less APIs (Open-Meteo, public RSS feeds, Yahoo Finance).
# DEFAULT_CITY is used for weather in the daily briefing and proactive greeting.
# DEFAULT_LAT / DEFAULT_LON override the city's built-in coordinates if needed.
DEFAULT_CITY=New Delhi
DEFAULT_LAT=
DEFAULT_LON=

# --- Scheduler Cron ------------------------------------------------------------
# Secret sent by the GitHub Actions workflow (.github/workflows/tick.yml) as
# "Authorization: Bearer <CRON_SECRET>" when it calls POST /api/scheduler/tick
# every hour. Set the same value in:
#   - Vercel project settings -> Environment Variables (so the server can validate it)
#   - GitHub repo settings  -> Secrets and variables -> Actions -> CRON_SECRET
# If not set, /api/scheduler/tick falls back to normal Firebase auth.
CRON_SECRET=

# --- Secret Vault -------------------------------------------------------------
# 4-digit PIN that protects Master Nikhil's private Secret Vault.
# Change this to any 4-digit code you prefer. Default: 2005
SECRET_VAULT_PIN=2005
